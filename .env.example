# Copy to .env for local development. On cPanel, enter these in
# Setup Node.js App > Environment variables instead.

# Postgres connection string (add ?sslmode=require for hosted databases like Neon)
DATABASE_URL=postgres://user:password@host:5432/dbname

# pg  = normal connection on port 5432 (default)
# neon = Neon database over port 443 (use if your host blocks port 5432)
DB_DRIVER=pg

# For AI meal estimates from text/photos (optional; feature shows an error without it)
OPENAI_API_KEY=

# Max AI meal estimates per user per day (protects your OpenAI bill)
AI_LOOKUPS_PER_DAY=30

# Set to false to stop new people creating accounts
ALLOW_SIGNUPS=true

NODE_ENV=production
